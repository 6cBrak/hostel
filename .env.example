# Fichier .env pour le déploiement Docker (production) — à la racine du projet,
# à côté de docker-compose.yml. En local (hors Docker) utilisez plutôt backend/.env.
# Généré automatiquement par deploy/setup_vps.sh — ce fichier sert de référence.

SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=hostel.exemple.com

DB_NAME=hostelatoma_db
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=3306
DB_CONN_MAX_AGE=60

TIME_ZONE=Africa/Accra

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://hostel.exemple.com
CSRF_TRUSTED_ORIGINS=https://hostel.exemple.com

CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@hostel.exemple.com

MEDIA_URL=/media/
MEDIA_ROOT=media/

# Utilisé par docker-compose.yml pour le label Traefik (routage du domaine)
DOMAIN=hostel.exemple.com

# Optionnel — active l'envoi du backup quotidien par email (voir deploy/backup.sh)
# BACKUP_EMAIL_TO=vous@exemple.com
